{
  "name": "dsh-seven-appearance",
  "version": "1.0.0",
  "type": "module",
  "description": "Seven 外观（Seven Appearance）DeepSeek Harness 外观与效率套件（基于 GPL-3.0 Obsidian Prism 移植）：四套深浅主题、输入框棱镜流光、背景微光涟漪、统一模型与推理选择器、下一步提示词推荐、划词与右键侧边追问、像素伙伴、本地壁纸与中英双语外观工坊。",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Seven7cx",
    "url": "https://github.com/sevenqcx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sevenqcx/dsh-seven-appearance.git"
  },
  "homepage": "https://github.com/sevenqcx/dsh-seven-appearance#readme",
  "bugs": {
    "url": "https://github.com/sevenqcx/dsh-seven-appearance/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "appearance",
    "obsidian-prism",
    "mascot",
    "wallpaper"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "icon": "icon.svg",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check client.js",
    "test": "node scripts/build-client.mjs && node --test test/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "config.example.json",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/*.js",
    "vendor/dual-mascot-rig.js",
    "vendor/ripple-core.js",
    "vendor/crystal-prism-core.js",
    "scripts/build-client.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
